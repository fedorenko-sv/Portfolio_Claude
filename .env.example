# Public canonical origin. No trailing slash.
SITE_URL=https://fedorenkosv-portfolio.vercel.app
# Public bot username; set only after configuring Main Mini App in BotFather.
# TELEGRAM_BOT_USERNAME=YourPracticeBot

# Optional separate long-running bot process. Never NEXT_PUBLIC_.
# TELEGRAM_BOT_TOKEN=
# BOT_STATE_PATH=/absolute/path/on/persistent-disk/bot.sqlite

# VERCEL_ENV is supplied by Vercel; production hides unapproved programs.
# No OpenAI key, database or analytics credentials are required for R1-static.
